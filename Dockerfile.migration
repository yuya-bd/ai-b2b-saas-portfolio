# Migrations run as a one-off task before the application rolls out, so they
# ship as their own image containing only what drizzle-kit needs.
FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.14.2 --activate

COPY package.json pnpm-lock.yaml ./
COPY db ./db
COPY lib ./lib
COPY drizzle.config.ts ./

RUN pnpm install --frozen-lockfile

CMD ["pnpm", "db:migrate"]
