{
  "name": "saas-foundation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "dev": "next dev",
    "dev:all": "docker compose up -d --wait && (next dev & NODE_ENV=development tsx lib/workers/worker-env.ts & wait)",
    "dev:stop": "ps aux | grep 'worker-env\\|job-worker' | grep -v grep | awk '{print $2}' | xargs kill -9 2>/dev/null || true; ps aux | grep 'next dev' | grep -v grep | awk '{print $2}' | xargs kill -9 2>/dev/null || true; docker compose stop",
    "dev:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate && pnpm db:seed:dev",
    "dev:email-preview": "tsx scripts/send-preview-email.ts",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . --diagnostic-level=error",
    "lint:strict": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:all": "pnpm db:migrate && pnpm db:test:migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed-env.ts",
    "db:seed:dev": "SEED_ENV=dev tsx db/seed-env.ts",
    "db:dbml": "tsx scripts/generate-dbml.ts",
    "db:dev:create": "docker exec saas-foundation-db psql -U postgres -c 'CREATE DATABASE saas_foundation;'",
    "db:dev:drop": "docker exec saas-foundation-db psql -U postgres -c 'DROP DATABASE IF EXISTS saas_foundation WITH (FORCE);'",
    "db:dev:reset": "pnpm db:dev:drop && pnpm db:dev:create && pnpm db:migrate && pnpm db:seed:dev",
    "db:test:create": "docker exec saas-foundation-db psql -U postgres -c 'CREATE DATABASE saas_foundation_test;'",
    "db:test:drop": "docker exec saas-foundation-db psql -U postgres -c 'DROP DATABASE IF EXISTS saas_foundation_test WITH (FORCE);'",
    "db:test:migrate": "DATABASE_URL=postgres://postgres:postgres@localhost:5433/saas_foundation_test pnpm db:migrate",
    "db:test:reset": "pnpm db:test:drop && pnpm db:test:create && pnpm db:test:migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "worker:dev": "NODE_ENV=development tsx lib/workers/worker-env.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@aws-sdk/client-ses": "^3.975.0",
    "@aws-sdk/client-sqs": "^3.965.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@react-email/components": "^1.0.6",
    "better-auth": "^1.4.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "ioredis": "^5.9.3",
    "lucide-react": "^0.487.0",
    "next": "^16.0.10",
    "nodemailer": "^7.0.12",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-email": "^5.2.5",
    "react-hook-form": "^7.55.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.0.15",
    "dotenv": "^17.2.3",
    "drizzle-dbml-generator": "^0.10.0",
    "drizzle-kit": "^0.31.7",
    "nanoid": "^5.1.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.15"
  }
}
