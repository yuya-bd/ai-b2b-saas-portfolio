# Copy to .env.test. Loaded by `lib/test/setup.ts` before any test runs.
#
# Tests talk to a real Postgres — the *test* database, which is separate from
# the development one and is truncated as tests run. Create it once with:
#
#   pnpm db:test:create && pnpm db:test:migrate
#
# Host port 5433 is the docker-compose mapping, the same offset .env uses.
# Without this file the tests fall back to Postgres' default 5432 and every
# suite fails on connect.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/saas_foundation_test

# At least 32 characters. No test verifies a real session against it, so a
# fixed string is fine — and keeps runs reproducible.
BETTER_AUTH_SECRET=test-secret-key-for-testing-only-32-chars-min

# Namespaces the session cookie and cache keys, as in .env.
APP_SLUG=saas-foundation

# USE_MOCK_SQS and AI_PROVIDER are forced to their mocks by lib/test/setup.ts,
# so they are deliberately not set here.
