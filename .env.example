# Copy to .env and fill in. Never commit real values.

# ---------------------------------------------------------------------------
# Application identity
# ---------------------------------------------------------------------------
# Used as the session cookie prefix and as a namespace for cache keys.
# Changing it invalidates every existing session.
APP_SLUG=saas-foundation

# Public origin of the app. Also decides whether session cookies are marked
# Secure: an https:// value turns Secure on, http:// leaves it off so that a
# plain-HTTP staging host can still hold a session.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Host port 5433 is the docker-compose mapping. It is offset from the usual
# 5432 so this stack can run next to another project's Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/saas_foundation

# Connection pool ceiling. Development 10-20, test 50, production 30-50.
DB_POOL_MAX=20

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# Optional. When unset the cache layer degrades to querying the database
# directly, so the app still runs without Redis.
REDIS_URL=redis://localhost:6380

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-char-random-string

# How long an invitation link stays valid. Password reset links use the same
# window so that the two never disagree.
INVITATION_EXPIRY_DAYS=14

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
# Three modes, checked in this order:
#   USE_MOCK_SQS=true      in-process array. Tests use it. It lives inside one
#                          process, so a worker started separately never sees
#                          what the web process enqueued — jobs sit at PENDING
#                          forever. Not for local development.
#   SQS_ENDPOINT set       ElasticMQ from docker-compose. The local default;
#                          `pnpm dev:all` runs a real worker against it.
#   neither                real AWS SQS
USE_MOCK_SQS=false
SQS_ENDPOINT=http://localhost:9326
SQS_QUEUE_URL=http://localhost:9326/000000000000/job-queue
AWS_REGION=ap-northeast-1

# Only needed against real SQS. ElasticMQ accepts dummy credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# dev  -> SMTP, pointed at Mailpit (web UI on http://localhost:8026)
# ses  -> AWS SES
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=1026

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# /api/cron/* runs only when the request carries this value in the
# X-Cron-Secret header. Generate with: openssl rand -base64 32
CRON_SECRET=replace-with-a-random-string


AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_EFFORT=medium
# AI_MAX_OUTPUT_TOKENS=16000
# AI_MAX_RETRIES=2
# AI_TIMEOUT_MS=120000
